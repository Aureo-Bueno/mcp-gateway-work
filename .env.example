PORT=3000
DATABASE_URL=postgres://mcp:mcp@localhost:5432/mcp_gateway
REDIS_URL=redis://localhost:6379
GATEWAY_CONFIG=gateway.config.json
LOG_LEVEL=info
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
APPROVAL_TIMEOUT_SECONDS=120
CORS_ORIGIN=*
REDACTION_ENABLED=true
REDACTION_REPLACEMENT=***
HEALTH_CHECK_INTERVAL_SECONDS=30
READ_CACHE_ENABLED=true
READ_CACHE_TTL_SECONDS=30
READ_CACHE_MAX_ENTRIES=500

# Host ports published by docker-compose.yml (containers talk to each other on
# the internal network, so these only matter for access from your machine).
# Change them if the port is taken, and keep DATABASE_URL/REDIS_URL above in sync.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=3000